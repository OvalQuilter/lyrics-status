{
  "exclude": ["dist/**/*", "src/backup/**/*"],
  "compilerOptions": {
    "target": "es6",
    "lib": ["esnext", "es2015", "dom"],
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "noEmitOnError": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
