{
  "name": "lyrics-status",
  "version": "4.0.0",
  "description": "Display Spotify lyrics as your Discord status",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "start:cli": "node dist/index",
    "dev": "tsc && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:installer": "npm run build && electron-builder --win nsis --x64",
    "dist:all": "npm run build && electron-builder --win --x64 -p never"
  },
  "build": {
    "appId": "com.lyricsstatus.app",
    "productName": "LyricsStatus",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "res"
    },
    "files": [
      "dist/**/*",
      "static/**/*",
      "res/**/*",
      "data/**/*",
      "cache/**/*",
      "!**/*.ts",
      "!**/*.map",
      "!**/tsconfig.json",
      "!**/*.md",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/.git",
      "!**/.gitignore",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/tests/**",
      "!**/node_modules/**/docs/**",
      "!**/node_modules/**/.github/**"
    ],
    "extraResources": [
      {
        "from": "res/",
        "to": "res/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "res/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "splashImage": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "shortcutName": "LyricsStatus",
      "uninstallDisplayName": "LyricsStatus"
    },
    "asar": true,
    "asarUnpack": [
      "res/**/*",
      "static/**/*"
    ],
    "compression": "maximum",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "npmRebuild": true,
    "mac": {
      "target": "dmg",
      "icon": "res/icon.icns",
      "category": "public.app-category.music"
    },
    "linux": {
      "target": "AppImage",
      "icon": "res/icon.png",
      "category": "Audio"
    },
    "publish": null
  },
  "author": "nightgta",
  "license": "MIT",
  "homepage": "https://github.com/nightgta/lyrics-status",
  "repository": {
    "type": "git",
    "url": "https://github.com/nightgta/lyrics-status"
  },
  "dependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "express": "^4.21.2",
    "he": "^1.2.0",
    "level": "^10.0.0",
    "node-stream-zip": "^1.15.0",
    "totp-generator": "^1.0.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/he": "^1.2.3",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.0"
  }
}
